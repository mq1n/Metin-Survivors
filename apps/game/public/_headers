# Cloudflare Pages response headers for the static site. /api/* answers come from the Worker (via the Pages Function)
# and never get these. Every matching rule applies, in file order; `! Name` drops a value set by an earlier rule.
# scripts/deploy.ts checks the built dist/ against these rules (every /assets file except the manifests carries a
# content hash, so it may be cached forever) and adds a VITE_API_BASE origin to connect-src when one is configured.
#
# CSP: three.js + GLTFLoader decode meshopt with WebAssembly ('wasm-unsafe-eval'), turn embedded GLB textures into
# blob: URLs (img-src + connect-src blob:), index.html carries an inline <style> and the UI sets inline styles
# ('unsafe-inline' styles only — never executable scripts; <script type="application/ld+json"> is non-executable data);
# co-op opens a WebSocket on this origin (wss: listed for browsers whose 'self' does not cover ws schemes).
# frame-ancestors 'none': add a game portal's origin here to allow embedding.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob: data: wss://metin-survivors.com wss://www.metin-survivors.com wss://metin-survivors.pages.dev wss://*.metin-survivors.pages.dev; media-src 'self' blob: data:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), fullscreen=(self)
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  Cache-Control: no-cache

# root document: explicit search indexing directives + machine-readable discovery links (llms.txt, sitemap.xml)
/
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1
  Link: <https://metin-survivors.com/llms.txt>; rel="describedby"; type="text/plain", <https://metin-survivors.com/sitemap.xml>; rel="sitemap"; type="application/xml"

# content-hashed build output and assets (name.<hash>.ext / name-<hash>.js): never revalidate
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# the asset manifests keep stable names and point at the current hashes: always revalidate (ETag → 304)
/assets/manifest.json
  ! Cache-Control
  Cache-Control: no-cache

/assets/manifest/*
  ! Cache-Control
  Cache-Control: no-cache

# self-hosted fonts keep stable names: a day fresh, then served stale while revalidating
/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000

# the tab icons & PWA icons keep stable names and change about never: a month fresh, then served
# stale for a year while revalidating (instead of a revalidation on every page load under the /* no-cache above)
/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/favicon.ico
  ! Cache-Control
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/apple-touch-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/icons/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/manifest.webmanifest
  ! Cache-Control
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json; charset=utf-8

# social preview card (1200x630 JPEG): cache for a week so link scrapers do not re-fetch every time
/og-image.jpg
  ! Cache-Control
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# crawler policy, XML sitemap, and AI-readable llms.txt docs: short TTL so updates reach crawlers within the hour
/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=3600

/sitemap.xml
  ! Cache-Control
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

/llms.txt
  ! Cache-Control
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  ! Cache-Control
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

# IndexNow ownership verification key: keep out of search snippets while allowing verification crawlers
/6989479cdd344176a3a883ef7ecf8ce9.txt
  ! Cache-Control
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: noindex
